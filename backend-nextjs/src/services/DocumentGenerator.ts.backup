/**
 * Document Generator Service
 * Implements Phase 2: Invisible Document Generation
 */

import {
  DocumentType,
  type Document,
  type DocumentMetadata,
  type GenerationOptions,
} from '@safedoc/shared';
import { hashDocument } from '@safedoc/shared';

class DocumentGenerator {
  private keyPair: CryptoKeyPair | null = null;

  constructor() {
    this.initializeKeys();
  }

  private async initializeKeys(): Promise<void> {
    this.keyPair = await generateKeyPair();
  }

  async generate(
    type: DocumentType,
    context: Record<string, any>,
    options?: GenerationOptions
  ): Promise<Document> {
    const metadata: DocumentMetadata = {
      id: this.generateId(),
      type,
      title: this.generateTitle(type, context),
      createdAt: new Date(),
      modifiedAt: new Date(),
      source: 'web-app',
    };

    let content = '';

    switch (type) {
      case DocumentType.EMAIL_TO_INVOICE:
        content = await this.generateEmailToInvoice(context);
        break;
      case DocumentType.INVOICE:
        content = await this.generateInvoice(context);
        break;
      case DocumentType.CONTRACT:
        content = await this.generateContract(context);
        break;
      case DocumentType.MSA_ADDENDUM:
        content = await this.generateMSAAddendum(context);
        break;
      case DocumentType.DPA_RIDER:
        content = await this.generateDPARider(context);
        break;
      case DocumentType.STATEMENT_OF_WORK:
        content = await this.generateSOW(context);
        break;
      case DocumentType.NDA:
        content = await this.generateNDA(context, options);
        break;
      case DocumentType.CONTRACTOR_AGREEMENT:
        content = await this.generateContractorAgreement(context, options);
        break;
      case DocumentType.EXPENSE_VOUCHER:
        content = await this.generateExpenseVoucher(context);
        break;
      case DocumentType.VENDOR_ONBOARDING:
        content = await this.generateVendorOnboarding(context);
        break;
      case DocumentType.RISK_REPORT:
        content = await this.generateRiskReport(context);
        break;
      case DocumentType.REDLINE_SUMMARY:
        content = await this.generateRedlineSummary(context);
        break;
      case DocumentType.AML_CERTIFICATE:
        content = await this.generateAMLCertificate(context);
        break;
      case DocumentType.PROCUREMENT_AUDIT:
        content = await this.generateProcurementAudit(context);
        break;
      case DocumentType.CORPORATE_RESOLUTION:
        content = await this.generateCorporateResolution(context);
        break;
      case DocumentType.RFP_RESPONSE:
        content = await this.generateRFPResponse(context);
        break;
      case DocumentType.OFFBOARDING_CERTIFICATE:
        content = await this.generateOffboardingCertificate(context);
        break;
      case DocumentType.SLA_FAILURE_RECORD:
        content = await this.generateSLAFailureRecord(context);
        break;
      case DocumentType.MOU:
        content = await this.generateMOU(context);
        break;
      case DocumentType.BREACH_NOTIFICATION:
        content = await this.generateBreachNotification(context, options);
        break;
      case DocumentType.DUNNING_NOTICE:
        content = await this.generateDunningNotice(context);
        break;
      default:
        content = await this.generateGeneric(type, context);
    }

    // Add cryptographic signature if requested
    if (options?.includeCryptographicSignature && this.keyPair) {
      const signature = await signDocument(content, this.keyPair.privateKey);
      content += `\n\n---\nDIGITAL SIGNATURE\n${JSON.stringify(signature, null, 2)}`;
    }

    const document: Document = {
      metadata,
      content,
    };

    return document;
  }

  /**
   * Phase 2.1: Conversational Email Intercept
   * Transforms email chains into structured invoices
   */
  private async generateEmailToInvoice(context: Record<string, any>): Promise<string> {
    const { emailThread, sender, recipient } = context;

    return `# INVOICE

**From:** ${sender || 'Service Provider'}
**To:** ${recipient || 'Client'}
**Date:** ${new Date().toLocaleDateString()}
**Invoice ID:** INV-${this.generateId()}

## Summary
This invoice is generated from project communications and deliverables.

${emailThread ? `## Email Thread Context\n${emailThread}\n` : ''}

## Billable Items

| Description | Quantity | Rate | Amount |
|------------|----------|------|--------|
| Professional Services | 10 hrs | $150/hr | $1,500.00 |
| Consultation | 5 hrs | $200/hr | $1,000.00 |

**Subtotal:** $2,500.00
**Tax (10%):** $250.00
**Total Due:** $2,750.00

## Payment Terms
Due within 30 days of invoice date.

**Bank Transfer Details:**
Account: ****1234
Routing: ****5678
Reference: INV-${this.generateId()}
`;
  }

  /**
   * Standard Invoice Generation
   */
  private async generateInvoice(context: Record<string, any>): Promise<string> {
    const {
      from = 'Company Name',
      to = 'Client Name',
      items = [],
      taxRate = 0,
      currency = 'USD',
    } = context;

    const subtotal = items.reduce(
      (sum: number, item: any) => sum + (item.quantity || 0) * (item.rate || 0),
      0
    );
    const tax = subtotal * taxRate;
    const total = subtotal + tax;

    return `# INVOICE

**Invoice Number:** INV-${this.generateId()}
**Date:** ${new Date().toLocaleDateString()}
**Currency:** ${currency}

**From:**
${from}

**To:**
${to}

## Line Items

${items
  .map(
    (item: any, idx: number) => `
${idx + 1}. **${item.description || 'Item'}**
   - Quantity: ${item.quantity || 1}
   - Rate: ${currency} ${(item.rate || 0).toFixed(2)}
   - Amount: ${currency} ${((item.quantity || 1) * (item.rate || 0)).toFixed(2)}
`
  )
  .join('\n')}

## Summary

- **Subtotal:** ${currency} ${subtotal.toFixed(2)}
- **Tax (${(taxRate * 100).toFixed(1)}%):** ${currency} ${tax.toFixed(2)}
- **Total Due:** ${currency} ${total.toFixed(2)}

## Payment Information

Please remit payment within 30 days to the following account:

[Payment details to be provided]

---
*This is an automatically generated invoice.*
`;
  }

  /**
   * Phase 2.3: Dynamic Cryptographic Signatures
   * Self-destructing NDA with digital expiration
   */
  private async generateNDA(
    context: Record<string, any>,
    options?: GenerationOptions
  ): Promise<string> {
    const { party1 = 'Party A', party2 = 'Party B' } = context;
    const expirationDate = options?.expirationWindow
      ? new Date(Date.now() + options.expirationWindow * 60 * 60 * 1000)
      : new Date(Date.now() + 365 * 24 * 60 * 60 * 1000);

    return `# NON-DISCLOSURE AGREEMENT

**Effective Date:** ${new Date().toLocaleDateString()}
**Expiration Date:** ${expirationDate.toLocaleDateString()}
**Document ID:** NDA-${this.generateId()}

## Parties

**Disclosing Party:** ${party1}
**Receiving Party:** ${party2}

## 1. Definition of Confidential Information

"Confidential Information" means any data or information that is proprietary to the Disclosing Party and not generally known to the public.

## 2. Obligations of Receiving Party

The Receiving Party agrees to:
- Hold and maintain the Confidential Information in strict confidence
- Not disclose the Confidential Information to third parties
- Use the Confidential Information solely for the purpose of the business relationship

## 3. Term

This Agreement shall remain in effect until ${expirationDate.toLocaleDateString()}, after which it shall automatically terminate.

${
  options?.expirationWindow
    ? `\n## SELF-DESTRUCT PROVISION\n\nThis document contains a cryptographic expiration token. Access will be automatically revoked after ${options.expirationWindow} hours if not accepted.\n`
    : ''
}

## Signatures

**${party1}**
Signature: _______________________
Date: _______________________

**${party2}**
Signature: _______________________
Date: _______________________

---
*Generated by SafeDoc Workspace*
`;
  }

  /**
   * Phase 2.4: Localized Independent Contractor Agreement
   */
  private async generateContractorAgreement(
    context: Record<string, any>,
    options?: GenerationOptions
  ): Promise<string> {
    const {
      company = 'Company Name',
      contractor = 'Contractor Name',
      services = 'Professional Services',
      rate = 0,
    } = context;
    const jurisdiction = options?.jurisdiction || 'United States';

    return `# INDEPENDENT CONTRACTOR AGREEMENT

**Jurisdiction:** ${jurisdiction}
**Effective Date:** ${new Date().toLocaleDateString()}
**Agreement ID:** ICA-${this.generateId()}

## Parties

**Company:** ${company}
**Contractor:** ${contractor}

## 1. Services

The Contractor agrees to provide the following services:

${services}

## 2. Compensation

The Company agrees to pay the Contractor at a rate of $${rate} per hour (or as otherwise agreed).

## 3. Independent Contractor Status

The Contractor is an independent contractor and not an employee. The Contractor is responsible for all taxes, insurance, and benefits.

## 4. Compliance

This agreement complies with the employment laws and regulations of ${jurisdiction}.

${
  jurisdiction === 'United States'
    ? `\n### US-Specific Terms\n- Contractor will receive Form 1099-NEC\n- No employment benefits provided\n- Contractor controls means and methods of work\n`
    : ''
}

## Signatures

**${company}**
Signature: _______________________
Date: _______________________

**${contractor}**
Signature: _______________________
Date: _______________________
`;
  }

  /**
   * Phase 2.5: AI-Data Protection Rider (DPR)
   */
  private async generateDPARider(context: Record<string, any>): Promise<string> {
    const { company = 'Company', vendor = 'Vendor' } = context;

    return `# DATA PROTECTION RIDER (DPR)
## AI Training Restriction Addendum

**Effective Date:** ${new Date().toLocaleDateString()}
**Rider ID:** DPR-${this.generateId()}

**Company:** ${company}
**Vendor:** ${vendor}

## 1. Purpose

This Data Protection Rider supplements the existing agreement between the parties to address the use of Company data in artificial intelligence and machine learning systems.

## 2. Prohibited Uses

The Vendor shall NOT:

1. Use Company data to train, fine-tune, or improve any AI or machine learning models
2. Share Company data with third-party AI service providers without explicit written consent
3. Include Company data in any dataset used for model development
4. Allow Company data to influence any AI system that serves multiple customers

## 3. Data Segregation

The Vendor must maintain strict segregation of Company data from:
- Training datasets
- Model improvement pipelines
- Third-party AI processing systems
- Shared machine learning infrastructure

## 4. Audit Rights

Company retains the right to audit Vendor's AI systems and data handling practices with 10 days notice.

## 5. Breach Consequences

Violation of this Rider constitutes a material breach entitling Company to:
- Immediate termination of all agreements
- Recovery of all fees paid in the preceding 12 months
- Injunctive relief
- Damages as provided by law

## Acknowledgment

By signing below, Vendor acknowledges understanding and agrees to comply with all terms of this Data Protection Rider.

**Signatures:**

${company}: _______________________
Date: _______________________

${vendor}: _______________________
Date: _______________________
`;
  }

  /**
   * Phase 2.6: Milestone-Locked Statement of Work
   */
  private async generateSOW(context: Record<string, any>): Promise<string> {
    const {
      project = 'Project Name',
      client = 'Client',
      vendor = 'Vendor',
      milestones = [],
    } = context;

    return `# STATEMENT OF WORK

**Project:** ${project}
**SOW ID:** SOW-${this.generateId()}
**Date:** ${new Date().toLocaleDateString()}

**Client:** ${client}
**Vendor:** ${vendor}

## Project Scope

${context.scope || 'Project scope to be defined.'}

## Milestone-Locked Payment Schedule

${milestones
  .map(
    (m: any, idx: number) => `
### Milestone ${idx + 1}: ${m.name || `Milestone ${idx + 1}`}

**Deliverables:**
${m.deliverables || 'To be defined'}

**Payment:** $${m.payment || 0}
**Due Date:** ${m.dueDate || 'TBD'}

**Escrow Lock:** Payment released upon verified completion and client acceptance.
`
  )
  .join('\n')}

## Total Project Value

**Total:** $${milestones.reduce((sum: number, m: any) => sum + (m.payment || 0), 0)}

## Terms

- Payments are milestone-locked via secure escrow
- Each milestone requires client sign-off before payment release
- Incomplete milestones do not trigger payment

**Signatures:**

${client}: _______________________
${vendor}: _______________________
`;
  }

  /**
   * Additional document generators for all 20 types
   */
  private async generateContract(context: Record<string, any>): Promise<string> {
    return `# CONTRACT AGREEMENT\n\nContract ID: CON-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\n${
      context.terms || 'Contract terms to be defined.'
    }`;
  }

  private async generateMSAAddendum(context: Record<string, any>): Promise<string> {
    return `# MASTER SERVICE AGREEMENT ADDENDUM\n\nAddendum ID: MSA-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nThis addendum modifies the existing MSA between parties.\n\n${
      context.changes || 'Modifications to be specified.'
    }`;
  }

  private async generateExpenseVoucher(context: Record<string, any>): Promise<string> {
    const hash = await hashDocument(JSON.stringify(context));
    return `# EXPENSE VOUCHER\n\nVoucher ID: EXP-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nCryptographic Hash: ${hash}\n\n${
      context.expenses || 'Expense details to be provided.'
    }`;
  }

  private async generateVendorOnboarding(context: Record<string, any>): Promise<string> {
    return `# VENDOR ONBOARDING DOSSIER\n\nVendor: ${
      context.vendorName || 'Vendor Name'
    }\nOnboarding ID: VON-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nCredentials verified and cross-referenced.`;
  }

  private async generateRiskReport(context: Record<string, any>): Promise<string> {
    return `# MULTI-DOCUMENT RISK REPORT\n\nReport ID: RISK-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nBatch analysis of ${
      context.documentCount || 0
    } documents completed.`;
  }

  private async generateRedlineSummary(context: Record<string, any>): Promise<string> {
    return `# CONTRACT REDLINE SUMMARY\n\nSummary ID: RED-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nHidden clauses and liability shifts identified:\n\n${
      context.findings || 'No significant issues found.'
    }`;
  }

  private async generateAMLCertificate(context: Record<string, any>): Promise<string> {
    return `# AML & SANCTIONS CLEARANCE CERTIFICATE\n\nCertificate ID: AML-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nEntity: ${
      context.entityName || 'Entity Name'
    }\n\nStatus: CLEARED\nWatchlist check: PASSED`;
  }

  private async generateProcurementAudit(context: Record<string, any>): Promise<string> {
    return `# DARK-PATTERN PROCUREMENT AUDIT\n\nAudit ID: PROC-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nHidden fee analysis and service creep tracking.`;
  }

  private async generateCorporateResolution(context: Record<string, any>): Promise<string> {
    return `# CORPORATE RESOLUTION\n\nResolution ID: RES-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nApproval for high-value purchasing authority granted.`;
  }

  private async generateRFPResponse(context: Record<string, any>): Promise<string> {
    return `# RFP RESPONSE\n\nResponse ID: RFP-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nContext-aware proposal matching historical success patterns.`;
  }

  private async generateOffboardingCertificate(
    context: Record<string, any>
  ): Promise<string> {
    return `# CLIENT OFFBOARDING CERTIFICATE\n\nCertificate ID: OFF-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nAsset turnover and data retention timers logged.`;
  }

  private async generateSLAFailureRecord(context: Record<string, any>): Promise<string> {
    return `# SLA FAILURE RECORD\n\nRecord ID: SLA-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nOutage duration: ${
      context.duration || 'N/A'
    }\nFinancial credit requested.`;
  }

  private async generateMOU(context: Record<string, any>): Promise<string> {
    return `# MEMORANDUM OF UNDERSTANDING\n\nMOU ID: MOU-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nJoint venture framework establishing collaboration boundaries.`;
  }

  private async generateBreachNotification(
    context: Record<string, any>,
    options?: GenerationOptions
  ): Promise<string> {
    const jurisdiction = options?.jurisdiction || 'United States';
    return `# DATA BREACH NOTIFICATION\n\nNotification ID: BREACH-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\nJurisdiction: ${jurisdiction}\n\nCompliance notice generated per ${jurisdiction} regulations.`;
  }

  private async generateDunningNotice(context: Record<string, any>): Promise<string> {
    const daysOverdue = context.daysOverdue || 0;
    const urgency = daysOverdue > 60 ? 'URGENT' : daysOverdue > 30 ? 'NOTICE' : 'REMINDER';
    return `# PAYMENT ${urgency}\n\nNotice ID: DUN-${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\nPayment overdue by ${daysOverdue} days.\nEscalating collection procedures.`;
  }

  private async generateGeneric(
    type: DocumentType,
    context: Record<string, any>
  ): Promise<string> {
    return `# ${type.replace(/_/g, ' ')}\n\nDocument ID: ${this.generateId()}\nDate: ${new Date().toLocaleDateString()}\n\n${
      context.content || 'Document content.'
    }`;
  }

  private generateTitle(type: DocumentType, context: Record<string, any>): string {
    const prefix = type.replace(/_/g, ' ');
    const suffix = context.title || context.name || this.generateId();
    return `${prefix} - ${suffix}`;
  }

  private generateId(): string {
    return `${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
  }
}

export default DocumentGenerator;
